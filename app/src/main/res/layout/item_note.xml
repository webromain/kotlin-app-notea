<?xml version="1.0" encoding="utf-8"?>
<!-- Layout d'un item de note dans la liste -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Icône de modification (crayon) -->
        <ImageView
            android:id="@+id/iconEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Éditer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#666666"/>

        <!-- Titre de la note -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Aller à la salle"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toEndOf="@id/iconEdit"
            app:layout_constraintEnd_toStartOf="@id/checkBox"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Contenu de la note -->
        <TextView
            android:id="@+id/contentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Faire tous mes exercices jusqu'à l'échec"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/titleText"
            app:layout_constraintEnd_toEndOf="@id/titleText"
            app:layout_constraintTop_toBottomOf="@id/titleText"/>

        <!-- Badge de priorité -->
        <TextView
            android:id="@+id/priorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Urgent !"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/badge_background"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/titleText"
            app:layout_constraintTop_toBottomOf="@id/contentText"/>

        <!-- Date d'échéance -->
        <TextView
            android:id="@+id/dueDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10/11/2025"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentText"/>

        <!-- Checkbox pour marquer comme complété -->
        <CheckBox
            android:id="@+id/checkBox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>